{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/adh-studio/supply-dbt-warehouse/catalogue/schema/data_product.schema.json",
  "title": "Data product du catalogue supply-dbt-warehouse",
  "description": "Declaration d'un data product cote producteur : un YAML par produit de donnees, valide par le moteur catalogue de supply-data-agents.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "nom",
    "domaine",
    "description",
    "owner",
    "ports_de_sortie",
    "contrat_reference",
    "slo",
    "consommateurs",
    "version",
    "changelog"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]+$",
      "description": "Identifiant technique du data product (snake_case)."
    },
    "nom": {
      "type": "string",
      "minLength": 3,
      "description": "Nom metier affiche dans le catalogue."
    },
    "domaine": {
      "type": "string",
      "enum": ["supply", "offre"],
      "description": "Domaine proprietaire du data product (data mesh)."
    },
    "description": {
      "type": "string",
      "minLength": 30,
      "description": "Description metier en francais : ce que le data product apporte, dans l'univers import-distribution Madagascar."
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nom", "role"],
      "properties": {
        "nom": { "type": "string", "minLength": 2 },
        "role": { "type": "string", "minLength": 2 }
      },
      "description": "Responsable du data product : a qui parler pour le consommer ou le faire evoluer."
    },
    "ports_de_sortie": {
      "type": "array",
      "minItems": 1,
      "description": "Les tables (marts dbt) exposees par ce data product, avec leurs colonnes cles.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["table", "grain", "colonnes"],
        "properties": {
          "table": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]+$",
            "description": "Nom du mart dbt dans l'entrepot DuckDB."
          },
          "grain": {
            "type": "string",
            "minLength": 3,
            "description": "Grain de la table (une ligne par ...)."
          },
          "colonnes": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["nom", "sens"],
              "properties": {
                "nom": { "type": "string", "minLength": 1 },
                "sens": {
                  "type": "string",
                  "minLength": 10,
                  "description": "Sens metier de la colonne, en francais."
                }
              }
            }
          }
        }
      }
    },
    "contrat_reference": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]+\\.odcs\\.yaml$",
      "description": "Fichier du contrat ODCS de contracts/ qui gouverne les sources de ce data product."
    },
    "slo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fraicheur_heures", "completude_pct", "disponibilite"],
      "properties": {
        "fraicheur_heures": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Age maximal promis du dernier build reussi, en heures (build nocturne 2 h 30 + marge)."
        },
        "completude_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Part minimale promise des entites du perimetre presentes dans le mart."
        },
        "disponibilite": {
          "type": "string",
          "minLength": 5,
          "description": "Fenetre de disponibilite promise aux consommateurs."
        }
      }
    },
    "consommateurs": {
      "type": "array",
      "minItems": 1,
      "description": "Consommateurs declares : vues SupplySense, modules agents, exports.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "id"],
        "properties": {
          "type": { "type": "string", "enum": ["vue", "module", "export"] },
          "id": { "type": "string", "minLength": 2 },
          "usage": { "type": "string" }
        }
      }
    },
    "question_exemple": {
      "type": "string",
      "minLength": 10,
      "description": "Question type a poser a l'assistant SupplySense sur ce data product (bouton Explorer)."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Version semantique du data product."
    },
    "changelog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "date", "description", "auteur"],
        "properties": {
          "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "description": { "type": "string", "minLength": 5 },
          "auteur": { "type": "string", "minLength": 2 }
        }
      }
    }
  }
}
